# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts and Docker-related files must keep LF endings even when the
# repo is checked out on Windows, otherwise they fail inside Linux containers.
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

# Binary assets
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
