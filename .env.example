# HTX Document Analyst - environment configuration.
# Copy to .env and adjust. Every value has a safe default in backend/app/config.py,
# so the app runs even if this file is absent.

# LLM provider: "ollama" (local model) or "mock" (deterministic, no model needed)
LLM_PROVIDER=ollama
# Docker Compose service name. For a native Ollama install use http://127.0.0.1:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct
# 16k fits an 8 GB GPU only if the Ollama SERVER runs with OLLAMA_FLASH_ATTENTION=1 and
# OLLAMA_KV_CACHE_TYPE=q8_0 (set on the compose ollama service; see docs/DECISIONS.md D-023).
# Without them, use 8192.
OLLAMA_NUM_CTX=16384
LLM_TIMEOUT_SECONDS=300
# Mock provider only: seconds to pause per call, so progress is visible in demos (0 = instant)
MOCK_DELAY_SECONDS=0

# Upload limits
MAX_FILES=10
MAX_FILE_MB=25
MAX_PAGES=60

# Visual analysis
MAX_VISUAL_PAGES_PER_DOC=20
RENDER_DPI=150

# Security: "reject" (default) or "warn" for PDFs containing JavaScript / launch actions / embedded files
ACTIVE_CONTENT_POLICY=reject

# Mask NRIC/FIN and phone numbers in model output (true) or show them as written (false).
MASK_PII=true

# Keep uploaded PDFs after processing (default false: deleted once processed)
RETAIN_UPLOADS=false

# Logging and storage
LOG_LEVEL=INFO
DATA_DIR=/data
