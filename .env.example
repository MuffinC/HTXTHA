# HTX Document Analyst - environment configuration.
# Copy to .env and adjust. Every value has a safe default in backend/app/config.py,
# so the app runs even if this file is absent.

# LLM provider: "ollama" (local model) or "mock" (deterministic, no model needed)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_NUM_CTX=16384
LLM_TIMEOUT_SECONDS=300

# Upload limits
MAX_FILES=10
MAX_FILE_MB=25
MAX_PAGES=60

# Visual analysis
MAX_VISUAL_PAGES_PER_DOC=20
RENDER_DPI=150

# Security: "reject" (default) or "warn" for PDFs containing JavaScript / launch actions / embedded files
ACTIVE_CONTENT_POLICY=reject

# Keep uploaded PDFs after processing (default false: deleted once processed)
RETAIN_UPLOADS=false

# Logging and storage
LOG_LEVEL=INFO
DATA_DIR=/data
