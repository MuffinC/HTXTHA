{
  "name": "htx-document-analyst-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "~5.3.0",
    "@fontsource/ibm-plex-sans": "~5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@testing-library/dom": "~10.4.1",
    "@testing-library/jest-dom": "~6.10.0",
    "@testing-library/react": "~16.3.0",
    "@types/node": "~22.20.5",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "@vitejs/plugin-react": "~5.2.0",
    "eslint": "~9.39.5",
    "eslint-plugin-react-hooks": "~5.2.0",
    "eslint-plugin-react-refresh": "~0.4.26",
    "globals": "~16.5.0",
    "jsdom": "~26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.73.0",
    "vite": "~7.3.8",
    "vitest": "~4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
